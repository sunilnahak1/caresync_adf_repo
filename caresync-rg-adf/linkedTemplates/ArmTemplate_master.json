{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "caresync-rg-adf"
		},
		"AzureDatabricksLS_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1125-080008-blhcw8t7"
		},
		"AzureKeyVaultls_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-rg-sunil-kv.vault.azure.net/"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-sunil-server.database.windows.net"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresyncsql-sunil-db"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "user"
		},
		"caresync_PostgreSql_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-twilight-waterfall-aok75v22-pooler.c-2.ap-southeast-1.aws.neon.tech"
		},
		"caresync_PostgreSql_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"caresync_PostgreSql_ls_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"caresync_adls_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncrgstg.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "caresync-rg-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureKeyVaultls_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVaultls_properties_typeProperties_baseUrl')]"
					},
					"caresync_adls_ls_properties_typeProperties_url": {
						"value": "[parameters('caresync_adls_ls_properties_typeProperties_url')]"
					},
					"AzureDatabricksLS_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricksLS_properties_typeProperties_existingClusterId')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_userName')]"
					},
					"caresync_PostgreSql_ls_properties_typeProperties_server": {
						"value": "[parameters('caresync_PostgreSql_ls_properties_typeProperties_server')]"
					},
					"caresync_PostgreSql_ls_properties_typeProperties_database": {
						"value": "[parameters('caresync_PostgreSql_ls_properties_typeProperties_database')]"
					},
					"caresync_PostgreSql_ls_properties_typeProperties_username": {
						"value": "[parameters('caresync_PostgreSql_ls_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}